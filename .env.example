# Copy to ".env" (or export in your shell). Keys are read from these names:
API_KEY_GROQ_ANUJ=
API_KEY_GEMINI_ANUJ=
# Optional
ANTHROPIC_API_KEY=
# Bucket and credentials for S3 storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=data
# Postgres database
DATABASE_URL=
# Optional separate executor. Use HTTPS remotely; leave empty to keep execution disabled.
# CODE_EXECUTOR_TOKEN should be a randomly generated secret of at least 32 characters.
CODE_EXECUTOR_URL=
CODE_EXECUTOR_TOKEN=
